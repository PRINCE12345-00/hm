# ==========================================
# BACKEND ENVIRONMENT VARIABLES (server.js)
# ==========================================

# Server Port
PORT=3001

# MongoDB Connection String (Optional: leave blank or omit to use local data/store.json)
MONGO_URI=mongodb://127.0.0.1:27017/haryana_mandli

# Allowed CORS Origin for Frontend
CLIENT_ORIGIN=http://localhost:5173

# Secret key for JWT Authentication tokens (Change to a strong secret in production)
JWT_SECRET=change-this-to-a-secure-jwt-secret-key-12345

# Initial Super Admin Credentials (Created automatically on server startup if not existing)
ADMIN_EMAIL=admin@haryanamandli.in
ADMIN_PASSWORD=change-this-admin-password

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vite / React)
# ==========================================
# Note: Vite environment variables MUST start with "VITE_"

# Backend API base URL
VITE_API_URL=http://localhost:3001/api
